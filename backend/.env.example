# Copy this file to backend/.env and fill in the provider credentials you use.
#
# LiteLLM model naming examples:
#   LITELLM_MODEL=openai/gpt-4o-mini
#   LITELLM_MODEL=anthropic/claude-3-5-sonnet-20241022
#   LITELLM_MODEL=openrouter/openai/gpt-4o-mini
#   LITELLM_MODEL=ollama_chat/qwen2.5:7b
#
# Provider credentials stay on the server. Never put them in frontend .env files.

LITELLM_MODEL=openai/gpt-4o-mini
LITELLM_TIMEOUT_SECONDS=45
LITELLM_MAX_TOKENS=900
LITELLM_TEMPERATURE=0.2

# Backend Agent Host limits.
WATERCLAW_ENVIRONMENT=development
WATERCLAW_AGENT_MAX_STEPS=8
WATERCLAW_SQLITE_PATH=backend/.waterclaw/waterclaw.db
LITELLM_LOCAL_MODEL_COST_MAP=true
WATERCLAW_SESSION_BACKEND=sqlite
WATERCLAW_SESSION_TTL_SECONDS=3600
WATERCLAW_SESSION_CACHE_SIZE=256
# REDIS_URL=redis://127.0.0.1:6379/0

# MCP client gateway. Keep disabled for local demo unless real MCP servers are reachable.
WATERCLAW_MCP_ENABLED=false
WATERCLAW_MCP_CONFIG_PATH=backend/.mcp.json
WATERCLAW_MCP_CALL_TIMEOUT_SECONDS=20
WATERCLAW_MOCK_FALLBACK_ENABLED=true

# OpenTelemetry tracing.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# Optional OpenAI-compatible endpoint override.
# LITELLM_API_BASE=https://api.openai.com/v1

# Provider keys. Set the one matching your model/provider.
# OPENAI_API_KEY=<your-openai-api-key>
# ANTHROPIC_API_KEY=<your-anthropic-api-key>
# OPENROUTER_API_KEY=<your-openrouter-api-key>

# Optional local API guard. If set, frontend requests must send X-WaterClaw-LLM-Key.
# WATERCLAW_LLM_GATEWAY_KEY=
# Optional Agent API guard. Set this outside local development and send Bearer/X-WaterClaw-Agent-Key.
# WATERCLAW_AGENT_API_KEY=

# Optional approval challenge code. Leave empty in local development if long-press approval is enough.
# WATERCLAW_APPROVAL_CODE=
# WATERCLAW_APPROVAL_PEPPER=replace-with-secret-pepper

# CORS origins for development.
WATERCLAW_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

